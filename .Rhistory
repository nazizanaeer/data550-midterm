cost
}
#total cost #
J = function(theta0, theta1,theta2, m, x1,x2, y){
## inv.logit is the sigmoid function in the "boot" package ##
yhat = inv.logit(theta0 + theta1*x1 + theta2*x2)
sum_cost = (1/m)*sum(mapply(FUN=cost,y,yhat))
